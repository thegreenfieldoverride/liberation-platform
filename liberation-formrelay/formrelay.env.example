# Liberation Form Relay — example configuration
#
# The real file lives at /etc/liberation/formrelay.env on the Hetzner box,
# root-owned and 0600, alongside postfix.env / listmonk.env / postgres.env.
# It is passed with `sudo docker run --env-file`, which the docker CLI reads
# as root — so the container can still run unprivileged without needing read
# access to the file itself.
#
# NOTHING IN THE REAL FILE BELONGS IN GIT. The whole point of this service is
# that recipient addresses are not published anywhere.

# Map of opaque form id -> destination. Must be valid JSON on a single line.
#
# Generate ids with: openssl rand -hex 6
#
# The id never appears in the public page either — box 2's Caddyfile rewrites
# /api/contact to /f/<id>, so the browser only ever sees a path on its own
# origin. "origin" is only consulted for the CORS path, when a browser posts
# here cross-origin rather than through the proxy.
FORM_RELAY_FORMS={"REPLACE_WITH_RANDOM_HEX":{"origin":"https://example.com","to":"you@example.com","subject":"example.com contact"}}

# Envelope sender and From:. Must be a domain in the opendkim SigningTable
# (daon.network, greenfieldoverride.com, writewithstrata.app) or the mail
# leaves unsigned and Gmail files it as spam.
MAIL_FROM=noreply@greenfieldoverride.com

# Postfix on the internal docker network. Port 25 there is
# permit_mynetworks,reject — it accepts from the bridge and from nowhere else.
SMTP_ADDR=liberation-postfix:25

# Shared secret injected by box 2's Caddy as X-Relay-Token. Without it, this
# endpoint is publicly postable and the same-origin property protects your
# visitors but not your inbox. Generate with: openssl rand -hex 32
RELAY_TOKEN=

# Where submissions are written before any mail is attempted. Back this up;
# it is the record that survives a postfix outage.
SPOOL_DIR=/var/spool/formrelay

# Reject anything filled faster than this. The scraper hitting the old form
# submitted 45ms after page load; a human took 86 seconds.
MIN_FILL_SECONDS=3

# Per-IP submissions per hour.
RATE_PER_HOUR=5

LISTEN_ADDR=:8090

# Optional. Set to a PEM bundle to turn on verified STARTTLS to postfix.
# Leave unset: postfix currently self-signs with no SAN and regenerates the
# cert every deploy, so nothing can verify it. See the comment in send().
# SMTP_TLS_CA=
