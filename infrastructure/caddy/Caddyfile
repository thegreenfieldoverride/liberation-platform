greenfieldoverride.com {
    reverse_proxy localhost:3000
    
    log {
        output file /mnt/analytics-volume/logs/caddy/main-platform.log {
            roll_size 100MB
            roll_keep 20
            roll_keep_for 2160h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

staging.greenfieldoverride.com {
    reverse_proxy localhost:3001
    
    log {
        output file /mnt/analytics-volume/logs/caddy/staging.log {
            roll_size 50MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

analytics.greenfieldoverride.com {
    # CORS is handled entirely by the analytics service via ALLOWED_ORIGINS.
    # Caddy previously set its own headers on top, which produced two
    # Access-Control-Allow-Origin headers on every allowed-origin response —
    # and per the Fetch spec more than one fails the CORS check outright.
    # One source of truth; change origins in the container env, not here.
    reverse_proxy localhost:8080
    
    log {
        output file /mnt/analytics-volume/logs/caddy/analytics.log {
            roll_size 100MB
            roll_keep 20
            roll_keep_for 2160h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }
    
}

# WWW redirect for main domain
www.greenfieldoverride.com {
    redir https://greenfieldoverride.com{uri} permanent
}

# Optional: WWW redirects for subdomains (if needed)
www.analytics.greenfieldoverride.com {
    redir https://analytics.greenfieldoverride.com{uri} permanent
}

www.staging.greenfieldoverride.com {
    redir https://staging.greenfieldoverride.com{uri} permanent
}
