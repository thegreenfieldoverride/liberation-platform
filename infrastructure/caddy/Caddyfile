greenfieldoverride.com {
    reverse_proxy localhost:3000
    
    log {
        output file /mnt/analytics-volume/logs/caddy/main-platform.log {
            roll_size 100MB
            roll_keep 20
            roll_keep_for 2160h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

staging.greenfieldoverride.com {
    reverse_proxy localhost:3001
    
    log {
        output file /mnt/analytics-volume/logs/caddy/staging.log {
            roll_size 50MB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

analytics.greenfieldoverride.com {
    # CORS is handled entirely by the analytics service via ALLOWED_ORIGINS.
    # Caddy previously set its own headers on top, which produced two
    # Access-Control-Allow-Origin headers on every allowed-origin response —
    # and per the Fetch spec more than one fails the CORS check outright.
    # One source of truth; change origins in the container env, not here.
    reverse_proxy localhost:8080
    
    log {
        output file /mnt/analytics-volume/logs/caddy/analytics.log {
            roll_size 100MB
            roll_keep 20
            roll_keep_for 2160h
        }
        format json
        level INFO
    }
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
    }
    
}

forms.greenfieldoverride.com {
    # Contact form endpoint for the static sites on the other box. They post
    # same-origin to their own /api/contact, and that box's caddy proxies here
    # with an X-Relay-Token; the relay refuses anything without it, so a direct
    # post to this hostname does not reach the mail path.
    #
    # No CORS headers here, deliberately. The relay owns them — same reason as
    # the analytics block above. Two Access-Control-Allow-Origin headers fail
    # the check outright.
    #
    # Loopback only on the upstream: the relay publishes to 127.0.0.1:8090 and
    # has no business being reachable on the public interface directly.
    reverse_proxy localhost:8090

    log {
        output file /mnt/analytics-volume/logs/caddy/forms.log {
            roll_size 100MB
            roll_keep 20
            roll_keep_for 2160h
        }
        format json
        level INFO
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

lists.greenfieldoverride.com {
    # CORS for the public subscription API only.
    #
    # listmonk answers POST /api/public/subscription but returns 404 for the
    # OPTIONS preflight, so a browser form on another origin never gets as far
    # as the POST. Caddy answers the preflight; listmonk handles the request.
    #
    # listmonk emits no CORS headers of its own — verified, 0 on every origin —
    # so Caddy is the single source here. That is deliberately unlike the
    # analytics vhost, where Caddy and the service both set them and produced
    # two Access-Control-Allow-Origin headers, which the Fetch spec rejects
    # outright.
    #
    # Scoped to /api/public/* and to known origins. The admin UI and every
    # other path are untouched and get no CORS headers at all.
    @cors_origin header_regexp origin Origin ^https://(writewithstrata\.app|greenfieldoverride\.com|daon\.network)$

    @public_preflight {
        method OPTIONS
        path /api/public/*
        header_regexp origin Origin ^https://(writewithstrata\.app|greenfieldoverride\.com|daon\.network)$
    }
    handle @public_preflight {
        header Access-Control-Allow-Origin "{re.origin.0}"
        header Access-Control-Allow-Methods "POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type"
        header Access-Control-Max-Age "86400"
        header Vary Origin
        respond 204
    }

    handle /api/public/* {
        header @cors_origin Access-Control-Allow-Origin "{re.origin.0}"
        header @cors_origin Vary Origin
        reverse_proxy localhost:9001
    }

    handle {
        reverse_proxy localhost:9001
    }

    log {
        output file /mnt/analytics-volume/logs/caddy/listmonk.log {
            roll_size 50MB
            roll_keep 10
        }
        format json
    }

    header {
        X-Content-Type-Options nosniff
        # SAMEORIGIN rather than DENY: listmonk's own admin UI frames its
        # campaign preview, which DENY breaks.
        X-Frame-Options SAMEORIGIN
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# WWW redirect for main domain
www.greenfieldoverride.com {
    redir https://greenfieldoverride.com{uri} permanent
}

# Removed: www.analytics and www.staging redirects.
#
# Neither name has ever had a DNS record. Caddy still tried to obtain a
# certificate for both on every load, ACME returned NXDOMAIN, and certmagic
# retried on a 300s backoff. systemd's reload timeout fired mid-retry, killed
# the reload process, and took the deploying SSH session with it (exit 255) —
# leaving caddy stuck in "reloading" while serving the previous config.
#
# A vhost for a name that does not resolve is not inert. It is a reload that
# fails later, during an unrelated deploy. If either name is ever wanted, add
# the DNS record first, then the block.
